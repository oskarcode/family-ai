{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker identity and runtime entrypoint.
  "name": "family-ai-core",
  "main": "src/worker/index.ts",
  // Exposure is limited to the custom domain; workers.dev and preview URLs stay disabled.
  "workers_dev": false,
  "preview_urls": false,
  // Runtime compatibility is pinned for repeatable deployments.
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  // Worker logs and traces are available for operational diagnosis.
  "observability": {
    "enabled": true
  },
  // D1 binding stores document metadata and uses the checked-in migration directory.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-ai-metadata",
      "database_id": "903967f3-ea5e-49d0-876d-ae81faad7204",
      "migrations_dir": "db/migrations"
    }
  ],
  // R2 bindings separate original, index-ready, and processed document lifecycles.
  "r2_buckets": [
    {
      "binding": "R2_RAW",
      "bucket_name": "family-raw"
    },
    {
      "binding": "R2_INDEX_READY",
      "bucket_name": "family-index-ready-v3"
    },
    {
      "binding": "R2_PROCESSED",
      "bucket_name": "family-processed"
    }
  ],
  // Queue binding publishes asynchronous document-processing jobs.
  "queues": {
    "producers": [
      {
        "binding": "PROCESSING_QUEUE",
        "queue": "family-processing-jobs"
      }
    ]
  },
  // Non-secret environment identity is safe to keep in version control.
  "vars": {
    "APP_ENV": "dev"
  },
  // Secrets such as API and Access credentials are injected with `wrangler secret put`.
  // The production hostname is the only configured public route.
  "routes": [
    {
      "pattern": "familyai.oskarcode.com",
      "custom_domain": true
    }
  ]
}
