# Local migration identity and R2 credentials; replace placeholders only in an untracked `.env`.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Optional bucket-name overrides for migration scripts.
R2_BUCKET_RAW=family-raw
R2_BUCKET_INDEX_READY=family-index-ready-v3

# Worker authentication and signing secrets are set with `wrangler secret put`, not stored here:
# CF_API_TOKEN
# ACCESS_CLIENT_ID
# ACCESS_CLIENT_SECRET
# PREFLIGHT_SIGNING_SECRET
