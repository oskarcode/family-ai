{
  "project": "Family AI",
  "scenarios": [
    {
      "id": "mcp-search",
      "title": "MCP search over family documents",
      "subtitle": "MCP client → Worker tool → AI Search binding → ranked chunks",
      "meta": { "created": "2026-10-14", "updated": "2026-10-14", "status": "verified" },
      "source_paths": ["src/ingest-worker/index.ts", "src/ingest-worker/server.ts", "src/ingest-worker/search.ts", "wrangler.ingest.jsonc"],
      "actors": [
        { "id": "client", "label": "MCP Client", "zone": "client", "sub_caption": "ChatGPT / Pi / Portal" },
        { "id": "worker", "label": "Family AI Worker", "zone": "server", "sub": [
          { "id": "entry", "label": "/mcp" },
          { "id": "tools", "label": "Tools" },
          { "id": "search", "label": "Search" }
        ] },
        { "id": "r2", "label": "R2", "zone": "external", "sub": [
          { "id": "raw", "label": "family-raw" },
          { "id": "legacy", "label": "index-ready" }
        ] },
        { "id": "ais", "label": "AI Search", "zone": "external", "sub_caption": "family-ai-chat-v3" }
      ],
      "messages": [
        { "phase": "REQUEST" },
        { "from": "client", "to": "worker.entry", "text": "POST /mcp", "caption": "tools/call search", "via": "api", "paths": ["search"], "src": "src/ingest-worker/index.ts" },
        { "self": "worker.entry", "text": "check Access", "caption": "optional service token" },
        { "from": "worker.entry", "to": "worker.tools", "text": "dispatch tool", "caption": "createUnifiedServer", "src": "src/ingest-worker/server.ts" },
        { "from": "worker.tools", "to": "worker.search", "text": "searchFamilyDocuments", "caption": "query + options", "src": "src/ingest-worker/server.ts → search.ts" },
        { "phase": "RETRIEVE" },
        { "from": "worker.search", "to": "ais", "text": "AI_SEARCH.search", "caption": "binding call", "via": "api", "paths": ["search"], "src": "src/ingest-worker/search.ts" },
        { "from": "ais", "to": "worker.search", "text": "ranked chunks", "kind": "ret" },
        { "from": "worker.search", "to": "r2.legacy", "text": "legacy prefix", "caption": "only when source_prefixes", "via": "io", "paths": ["prefix"] },
        { "from": "worker.search", "to": "worker.tools", "text": "structured result", "kind": "ret" },
        { "from": "worker.tools", "to": "client", "text": "tool response", "caption": "structuredContent", "kind": "ret" }
      ],
      "fragments": [
        { "kind": "opt", "label": "source_prefixes supplied", "range": [7, 8] }
      ]
    },
    {
      "id": "mcp-ingest-delete",
      "title": "Ingest and delete a family document",
      "subtitle": "preserve original in R2, index in AI Search built-in storage, clean both on delete",
      "meta": { "created": "2026-10-14", "updated": "2026-10-14", "status": "verified" },
      "source_paths": ["src/ingest-worker/ingestion.ts", "src/ingest-worker/deletion.ts", "src/ingest-worker/cloudflare-api.ts"],
      "actors": [
        { "id": "client", "label": "MCP Client", "zone": "client", "sub_caption": "upload/delete tools" },
        { "id": "worker", "label": "Family AI Worker", "zone": "server", "sub": [
          { "id": "tools", "label": "Tools" },
          { "id": "ingest", "label": "Ingestion" },
          { "id": "delete", "label": "Deletion" }
        ] },
        { "id": "r2", "label": "R2 Raw", "zone": "external", "sub_caption": "family-raw" },
        { "id": "ais", "label": "AI Search", "zone": "external", "sub_caption": "built-in storage" }
      ],
      "messages": [
        { "phase": "INGEST" },
        { "from": "client", "to": "worker.tools", "text": "call ingest", "caption": "file or markdown", "via": "api", "paths": ["ingest"] },
        { "from": "worker.tools", "to": "worker.ingest", "text": "validate input", "caption": "filename, type, size" },
        { "from": "worker.ingest", "to": "r2", "text": "put original", "caption": "canonical raw_key", "via": "io", "src": "src/ingest-worker/ingestion.ts" },
        { "from": "worker.ingest", "to": "ais", "text": "items.upload", "caption": "metadata fields", "via": "api", "src": "src/ingest-worker/cloudflare-api.ts" },
        { "from": "ais", "to": "worker.ingest", "text": "item id", "kind": "ret" },
        { "from": "worker.tools", "to": "client", "text": "upload result", "caption": "raw_key + item id", "kind": "ret" },
        { "phase": "DELETE" },
        { "from": "client", "to": "worker.tools", "text": "delete_file", "caption": "confirm_delete true", "via": "api", "paths": ["delete"] },
        { "from": "worker.tools", "to": "worker.delete", "text": "validate key", "caption": "safe path + prefix guard" },
        { "from": "worker.delete", "to": "r2", "text": "delete object", "caption": "raw/index/both", "via": "io" },
        { "from": "worker.delete", "to": "ais", "text": "find + delete item", "caption": "matching key", "via": "api" },
        { "from": "worker.delete", "to": "client", "text": "delete summary", "caption": "objects + item count", "kind": "ret" }
      ],
      "fragments": [
        { "kind": "critical", "label": "delete requires explicit confirmation", "range": [6, 10] }
      ]
    }
  ]
}
